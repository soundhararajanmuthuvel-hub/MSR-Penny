{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": [
    "./**/*",
    "../server/**/*"
  ],
  "exclude": [
    "../node_modules",
    "../dist"
  ]
}
