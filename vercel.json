{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/shortcut",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcut/(.*)",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcuts",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcuts/(.*)",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/cron"
    },
    {
      "source": "/api/push",
      "destination": "/api/push"
    },
    {
      "source": "/api/push/(.*)",
      "destination": "/api/push?action=$1"
    },
    {
      "source": "/api/data",
      "destination": "/api/data"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/data?route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
