{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/shortcut",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcut/(.*)",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcuts",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/shortcuts/(.*)",
      "destination": "/api/shortcut"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
