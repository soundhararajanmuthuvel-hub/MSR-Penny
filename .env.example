# ==============================================================================
# MSR Penny - Environment Configuration Example
# Copy this file to .env.local for local overrides. Never commit actual secrets!
# ==============================================================================

# Public App Name
VITE_APP_NAME="MSR Penny"

# Optional: Default Google Apps Script Webhook URL for Google Sheets Dual-Sync
# (Can also be configured directly in the app's Reports & Sync settings)
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEB_APP_ID/exec"

# Server-Side Google Apps Script Web App URL (used by Vercel serverless endpoints)
# Set this in Vercel Project Settings -> Environment Variables
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEB_APP_ID/exec"

# Dedicated Secret Token for iPhone Apple Shortcuts Integration
# Set this in Vercel Project Settings -> Environment Variables (Never commit real token!)
SHORTCUT_SECRET_TOKEN="your-secure-shortcut-secret-token"

# Web Push Notification VAPID Configuration (Daily Reminder)
# Set VITE_VAPID_PUBLIC_KEY in Vercel / frontend
VITE_VAPID_PUBLIC_KEY="BFumy3go8AuIfBnrtYBbst5Fksz3VkUbfJe23Q6Ydl6okux_S5BdX9hA9Jq679Evygnc_uh6fpYxb9Fs_cIa6t0"
# Set VAPID_PRIVATE_KEY only in Vercel serverless environment variables
VAPID_PRIVATE_KEY="your-server-side-vapid-private-key"
VAPID_SUBJECT="mailto:soundhararajanmuthuvel@gmail.com"

# Cron Secret for Daily Reminder Endpoint Protection (/api/cron/reminder)
CRON_SECRET="your-secure-cron-secret-token"

# Optional: Default WhatsApp contact number for Appa (with country code, e.g. +91XXXXXXXXXX)
# (Can also be configured in the app's Settings / Profile)
VITE_APPA_WHATSAPP_NUMBER="+919876543210"

# Server Port (used when running full-stack Node/Express)
PORT=3000
